{
	"name": "my-qwik-empty-starter",
	"description": "Blank project with routing included",
	"engines": {
		"node": "^18.17.0 || ^20.3.0 || >=21.0.0"
	},
	"engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "qwik build",
		"build.client": "vite build",
		"build.preview": "vite build --ssr src/entry.preview.tsx",
		"build.types": "tsc --incremental --noEmit",
		"deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
		"dev": "vite --mode ssr",
		"dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
		"drizzle:check": "drizzle-kit check",
		"drizzle:generate": "drizzle-kit generate",
		"drizzle:migrate": "drizzle-kit migrate",
		"drizzle:pull": "drizzle-kit pull",
		"drizzle:push": "drizzle-kit push",
		"drizzle:studio": "drizzle-kit studio",
		"drizzle:up": "drizzle-kit up",
		"fmt": "prettier --write .",
		"fmt.check": "prettier --check .",
		"lint": "eslint \"src/**/*.ts*\"",
		"postinstall": "drizzle-kit generate",
		"preview": "qwik build preview && vite preview --open",
		"start": "vite --open --mode ssr",
		"qwik": "qwik"
	},
	"devDependencies": {
		"@auth/qwik": "0.8.0",
		"@biomejs/biome": "2.3.11",
		"@builder.io/qwik": "^1.18.0",
		"@builder.io/qwik-city": "^1.18.0",
		"@eslint/js": "latest",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "20.19.0",
		"@types/pg": "^8.16.0",
		"better-sqlite3": "^11.8.1",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"eslint": "9.32.0",
		"eslint-plugin-qwik": "^1.18.0",
		"globals": "16.4.0",
		"prettier": "3.6.2",
		"typescript": "5.4.5",
		"typescript-eslint": "8.38.0",
		"typescript-plugin-css-modules": "latest",
		"undici": "*",
		"vite": "7.2.6",
		"vite-tsconfig-paths": "^4.2.1"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.1",
		"@fontsource/chocolate-classical-sans": "^5.2.11",
		"@fontsource/material-icons": "^5.2.7",
		"dotenv": "^17.2.3",
		"pg": "^8.16.3"
	}
}
